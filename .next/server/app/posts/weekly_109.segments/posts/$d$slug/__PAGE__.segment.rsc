n":"Weekly"}],false]}]]}],["$","div",null,{"children":[["$","p",null,{"children":"距离上一次写 blog 已经过去了两个多月之久。这段时间琐事很多，终于趁假期有时间对过去两个月做过的事情做下回顾。"}],"\n",["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"myshell","children":[["$","a",null,{"data-card":"","href":"#myshell","className":"peer","children":"MyShell"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","p",null,{"children":"MyShell 是一个 Web3 + AI 的创作平台。最近我在上面创建了两个 Bot，初衷都是为了解决现实生活中的具体需求。"}],"\n",["$","p",null,{"children":["第一个是美食博主 ",["$","$La",null,{"href":"https://www.youtube.com/@BlondieinChina","children":"Amy"}],"的数字分身。我很喜欢在 YouTube 或 B 站看 Amy 的美食 Vlog，她的视频多以中国美食为主题。我认为通过「谈论美食与文化」来练习英语口语，是一个非常有趣的切入点。"]}],"\n",["$","p",null,{"children":"第二个是 Zoe Chinese，这是一个利用 Pro Config 配置的中文学习工具，主要提供语法分析及 HSK 备考模拟。这个想法源于我之前加入的一个 Discord 语言交换群组，我发现群里有很多中文初学者都在为 HSK 考试而苦恼，于是便有了这个工具。"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["$","$La",null,{"href":"https://app.myshell.ai/bot/NZvmEr/1712738674","children":"Amy in China"}]}],"\n",["$","li",null,{"children":["$","$La",null,{"href":"https://app.myshell.ai/bot/uqEvia/1714033383","children":"Zoe Chinese"}]}],"\n"]}],"\n",["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"ton","children":[["$","a",null,{"data-card":"","href":"#ton","className":"peer","children":"Ton"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","str