0:{"buildId":"0InbTxRoIjIMCiN8Wi9i7","rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":3,"url":"#megi-是什么","title":"Megi 是什么"},{"depth":3,"url":"#比答案更重要的是提问的逻辑","title":"比答案更重要的，是提问的逻辑"},{"depth":3,"url":"#像整理笔记一样整理对话","title":"像整理笔记一样整理对话"},{"depth":3,"url":"#思考的留白","title":"思考的留白"},{"depth":3,"url":"#数据隐私","title":"数据隐私"},{"depth":3,"url":"#写在最后","title":"写在最后"}],"single":false,"children":["$","div",null,{"id":"nd-page","className":"flex flex-1 w-full mx-auto max-w-(--fd-page-width) pt-(--fd-tocnav-height) pe-(--fd-toc-width)","children":[["$","$L3",null,{"children":[["$","$L4",null,{}],["$","$L5",null,{"children":["$undefined",["$","$L6",null,{"children":["$","$L7",null,{}]}],"$undefined"]}]]}],["$","article",null,{"children":[["$","$L8",null,{}],[["$","p",null,{"className":"text-right","children":"2025/11/1"}],["$","h1",null,{"children":"Megi — 将线性对话，生长为思考的知识树","className":"text-[1.75em] font-semibold"}],["$","p",null,{"className":"text-lg text-fd-muted-foreground mb-0","children":"比答案更重要的是提问的逻辑。介绍我开发的工具 Megi — 它不仅是一个对话整理插件，更能将杂乱的 AI 对话记录重构为可视化的“思考树”，让发散的思维路径变得清晰可循，且数据完全本地存储。"}],["$","div",null,{"className":"flex gap-2 flex-wrap mb-8","children":[["$","$L9","Fun",{"href":"/tags/Fun","className":" group inline-flex items-center gap-1.5  px-3 py-1  text-sm font-medium rounded-md bg-fd-secondary text-fd-secondary-foreground transition-all duration-300 ease-out hover:bg-fd-accent hover:text-fd-accent-foreground dark:hover:bg-fd-primary dark:hover:text-fd-primary-foreground hover:scale-105 ","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-tag opacity-60 transition-opacity group-hover:opacity-100","aria-hidden":"true","children":[["$","path","vktsd0",{"d":"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"}],["$","circle","kqv944",{"cx":"7.5","cy":"7.5","r":".5","fill":"currentColor"}],"$undefined"]}],["$","span",null,{"children":"Fun"}],false]}],["$","$L9","Product",{"href":"/tags/Product","className":" group inline-flex items-center gap-1.5  px-3 py-1  text-sm font-medium rounded-md bg-fd-secondary text-fd-secondary-foreground transition-all duration-300 ease-out hover:bg-fd-accent hover:text-fd-accent-foreground dark:hover:bg-fd-primary dark:hover:text-fd-primary-foreground hover:scale-105 ","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-tag opacity-60 transition-opacity group-hover:opacity-100","aria-hidden":"true","children":[["$","path","vktsd0",{"d":"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"}],["$","circle","kqv944",{"cx":"7.5","cy":"7.5","r":".5","fill":"currentColor"}],"$undefined"]}],["$","span",null,{"children":"Product"}],false]}]]}],["$","div",null,{"children":[["$","p",null,{"children":"作为一个重度 AI 用户，在用 ChatGPT、豆包或 DeepSeek 处理复杂任务（比如写代码、构思文章）时，我经常遇到一个问题："}],"\n",["$","p",null,{"children":["$","strong",null,{"children":"“思维发散时，对话却只能线性堆叠。”"}]}],"\n",["$","p",null,{"children":["当我进行",["$","strong",null,{"children":"长下文对话"}],"时，思路往往是发散的。比如解决一个 Bug，我可能会针对 A 方案问几句，发现不行，又退回去针对 B 方案问几句。但在原本的网页里，这些对话全部混在一起，非常杂乱。"]}],"\n",["$","p",null,{"children":"过几天想找回当时的某个思路？基本只能靠鼠标滚轮疯狂向上翻页，去寻找当初的那个提问。"}],"\n",["$","p",null,{"children":["为了解决这个问题，我开发了 ",["$","strong",null,{"children":"Megi"}],"。"]}],"\n",["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"megi-是什么","children":[["$","a",null,{"data-card":"","href":"#megi-是什么","className":"peer","children":"Megi 是什么"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[["$La","$Lb"],"$undefined"]}]]}],"\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a"],"className":"prose flex-1"}],"$L2b","                          ","$L2c"],"$L2d","$L2e"],"className":"flex min-w-0 w-full flex-col gap-4 pt-8 px-4 md:px-6 md:mx-auto"}],"$L2f"]}]}],["$L30","$L31","$L32","$L33"],"$L34"]}],"loading":null,"isPartial":false}
