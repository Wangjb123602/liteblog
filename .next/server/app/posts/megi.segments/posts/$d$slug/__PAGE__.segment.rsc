38:T81a,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"Megi — 将线性对话，生长为思考的知识树","description":"比答案更重要的是提问的逻辑。介绍我开发的工具 Megi — 它不仅是一个对话整理插件，更能将杂乱的 AI 对话记录重构为可视化的“思考树”，让发散的思维路径变得清晰可循，且数据完全本地存储。","image":"http://localhost:3000/api/og?title=Megi+%E2%80%94+%E5%B0%86%E7%BA%BF%E6%80%A7%E5%AF%B9%E8%AF%9D%EF%BC%8C%E7%94%9F%E9%95%BF%E4%B8%BA%E6%80%9D%E8%80%83%E7%9A%84%E7%9F%A5%E8%AF%86%E6%A0%91&description=%E6%AF%94%E7%AD%94%E6%A1%88%E6%9B%B4%E9%87%8D%E8%A6%81%E7%9A%84%E6%98%AF%E6%8F%90%E9%97%AE%E7%9A%84%E9%80%BB%E8%BE%91%E3%80%82%E4%BB%8B%E7%BB%8D%E6%88%91%E5%BC%80%E5%8F%91%E7%9A%84%E5%B7%A5%E5%85%B7+Megi+%E2%80%94+%E5%AE%83%E4%B8%8D%E4%BB%85%E6%98%AF%E4%B8%80%E4%B8%AA%E5%AF%B9%E8%AF%9D%E6%95%B4%E7%90%86%E6%8F%92%E4%BB%B6%EF%BC%8C%E6%9B%B4%E8%83%BD%E5%B0%86%E6%9D%82%E4%B9%B1%E7%9A%84+AI+%E5%AF%B9%E8%AF%9D%E8%AE%B0%E5%BD%95%E9%87%8D%E6%9E%84%E4%B8%BA%E5%8F%AF%E8%A7%86%E5%8C%96%E7%9A%84%E2%80%9C%E6%80%9D%E8%80%83%E6%A0%91%E2%80%9D%EF%BC%8C%E8%AE%A9%E5%8F%91%E6%95%A3%E7%9A%84%E6%80%9D%E7%BB%B4%E8%B7%AF%E5%BE%84%E5%8F%98%E5%BE%97%E6%B8%85%E6%99%B0%E5%8F%AF%E5%BE%AA%EF%BC%8C%E4%B8%94%E6%95%B0%E6%8D%AE%E5%AE%8C%E5%85%A8%E6%9C%AC%E5%9C%B0%E5%AD%98%E5%82%A8%E3%80%82","datePublished":"2025-11-01T00:00:00.000Z","dateModified":"2026-04-24T13:53:56.000Z","mainEntityOfPage":{"@type":"WebPage","@id":"http://localhost:3000/posts/megi"},"author":{"@type":"Person","name":"shenn.xyz","url":"https://shenn.xyz"},"publisher":{"@type":"Person","name":"shenn.xyz"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"王浚博的博客","item":"http://localhost:3000/"},{"@type":"ListItem","position":2,"name":"王浚博的博客 | 文章列表","item":"http://localhost:3000/list"},{"@type":"ListItem","position":3,"name":"Megi — 将线性对话，生长为思考的知识树","item":"http://localhost:3000/posts/megi"}]}]}2c:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$38"}}]
