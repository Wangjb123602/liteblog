b3:T87b,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"动手实现一个vue分页组件","description":"本文记录了实现一个 Vue 分页组件的全过程，涵盖自定义页码数量、颜色主题及图标切换等需求分析。详细讲解了页码列表计算（minPage/maxPage）的核心逻辑，提供了 Props、Computed 和 Methods 的代码实现，并分享了关于编写独立组件与 API 设计的思考。","image":"http://localhost:3000/api/og?title=%E5%8A%A8%E6%89%8B%E5%AE%9E%E7%8E%B0%E4%B8%80%E4%B8%AAvue%E5%88%86%E9%A1%B5%E7%BB%84%E4%BB%B6&description=%E6%9C%AC%E6%96%87%E8%AE%B0%E5%BD%95%E4%BA%86%E5%AE%9E%E7%8E%B0%E4%B8%80%E4%B8%AA+Vue+%E5%88%86%E9%A1%B5%E7%BB%84%E4%BB%B6%E7%9A%84%E5%85%A8%E8%BF%87%E7%A8%8B%EF%BC%8C%E6%B6%B5%E7%9B%96%E8%87%AA%E5%AE%9A%E4%B9%89%E9%A1%B5%E7%A0%81%E6%95%B0%E9%87%8F%E3%80%81%E9%A2%9C%E8%89%B2%E4%B8%BB%E9%A2%98%E5%8F%8A%E5%9B%BE%E6%A0%87%E5%88%87%E6%8D%A2%E7%AD%89%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E3%80%82%E8%AF%A6%E7%BB%86%E8%AE%B2%E8%A7%A3%E4%BA%86%E9%A1%B5%E7%A0%81%E5%88%97%E8%A1%A8%E8%AE%A1%E7%AE%97%EF%BC%88minPage%2FmaxPage%EF%BC%89%E7%9A%84%E6%A0%B8%E5%BF%83%E9%80%BB%E8%BE%91%EF%BC%8C%E6%8F%90%E4%BE%9B%E4%BA%86+Props%E3%80%81Computed+%E5%92%8C+Methods+%E7%9A%84%E4%BB%A3%E7%A0%81%E5%AE%9E%E7%8E%B0%EF%BC%8C%E5%B9%B6%E5%88%86%E4%BA%AB%E4%BA%86%E5%85%B3%E4%BA%8E%E7%BC%96%E5%86%99%E7%8B%AC%E7%AB%8B%E7%BB%84%E4%BB%B6%E4%B8%8E+API+%E8%AE%BE%E8%AE%A1%E7%9A%84%E6%80%9D%E8%80%83%E3%80%82","datePublished":"2019-07-30T00:00:00.000Z","dateModified":"2026-04-24T13:53:56.000Z","mainEntityOfPage":{"@type":"WebPage","@id":"http://localhost:3000/posts/vue_component01"},"author":{"@type":"Person","name":"shenn.xyz","url":"https://shenn.xyz"},"publisher":{"@type":"Person","name":"shenn.xyz"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"王浚博的博客","item":"http://localhost:3000/"},{"@type":"ListItem","position":2,"name":"王浚博的博客 | 文章列表","item":"http://localhost:3000/list"},{"@type":"ListItem","position":3,"name":"动手实现一个vue分页组件","item":"http://localhost:3000/posts/vue_component01"}]}]}25:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML"