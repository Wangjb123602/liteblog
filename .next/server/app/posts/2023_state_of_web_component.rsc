8f:T6c4,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"2023 Web Components 现状","description":"2023 年 Web Components 生态报告：通过 Microsoft、Salesforce 等实战案例展示其成熟度，并详细梳理了 Shadow DOM 增强、Element Internals、声明式 Shadow DOM 以及 CSS 模块脚本等核心 API 的现状与未来提案。","image":"http://localhost:3000/api/og?title=2023+Web+Components+%E7%8E%B0%E7%8A%B6&description=2023+%E5%B9%B4+Web+Components+%E7%94%9F%E6%80%81%E6%8A%A5%E5%91%8A%EF%BC%9A%E9%80%9A%E8%BF%87+Microsoft%E3%80%81Salesforce+%E7%AD%89%E5%AE%9E%E6%88%98%E6%A1%88%E4%BE%8B%E5%B1%95%E7%A4%BA%E5%85%B6%E6%88%90%E7%86%9F%E5%BA%A6%EF%BC%8C%E5%B9%B6%E8%AF%A6%E7%BB%86%E6%A2%B3%E7%90%86%E4%BA%86+Shadow+DOM+%E5%A2%9E%E5%BC%BA%E3%80%81Element+Internals%E3%80%81%E5%A3%B0%E6%98%8E%E5%BC%8F+Shadow+DOM+%E4%BB%A5%E5%8F%8A+CSS+%E6%A8%A1%E5%9D%97%E8%84%9A%E6%9C%AC%E7%AD%89%E6%A0%B8%E5%BF%83+API+%E7%9A%84%E7%8E%B0%E7%8A%B6%E4%B8%8E%E6%9C%AA%E6%9D%A5%E6%8F%90%E6%A1%88%E3%80%82","datePublished":"2023-04-21T12:00:00.000Z","dateModified":"2026-04-24T13:53:56.000Z","mainEntityOfPage":{"@type":"WebPage","@id":"http://localhost:3000/posts/2023_state_of_web_component"},"author":{"@type":"Person","name":"shenn.xyz","url":"https://shenn.xyz"},"publisher":{"@type":"Person","name":"shenn.xyz"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"王浚博的博客","item":"http://localhost:3000/"},{"@type":"ListItem","position":2,"name":"王浚博的博客 | 文章列表","item":"http://localhost:3000/list"},{"@type":"ListItem","position":3,"name":"2023 Web Components 现状","item":"http://localhost:3000/posts/2023_state_of_web_component"}]}]}80:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$8f"}}]
