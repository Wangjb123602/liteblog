0:{"buildId":"0InbTxRoIjIMCiN8Wi9i7","rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#工具","title":"工具"},{"depth":2,"url":"#听的播客","title":"听的播客"},{"depth":2,"url":"#看的书","title":"看的书"}],"single":false,"children":["$","div",null,{"id":"nd-page","className":"flex flex-1 w-full mx-auto max-w-(--fd-page-width) pt-(--fd-tocnav-height) pe-(--fd-toc-width)","children":[["$","$L3",null,{"children":[["$","$L4",null,{}],["$","$L5",null,{"children":["$undefined",["$","$L6",null,{"children":["$","$L7",null,{}]}],"$undefined"]}]]}],["$","article",null,{"children":[["$","$L8",null,{}],[["$","p",null,{"className":"text-right","children":"2023/6/4"}],["$","h1",null,{"children":"Week in Jun 04, 2023","className":"text-[1.75em] font-semibold"}],["$","p",null,{"className":"text-lg text-fd-muted-foreground mb-0","children":"本周回顾了英超收官与连绵雨季。技术方面尝试了 Databerry、yt-fts 等工具，并利用 Gamma 辅助完成了黑客松项目；播客中聆听了尤雨溪关于 Vue 成功的思考，同时开始阅读迟子建的《额尔古纳河右岸》。"}],["$","div",null,{"className":"flex gap-2 flex-wrap mb-8","children":[["$","$L9","Weekly",{"href":"/tags/Weekly","className":" group inline-flex items-center gap-1.5  px-3 py-1  text-sm font-medium rounded-md bg-fd-secondary text-fd-secondary-foreground transition-all duration-300 ease-out hover:bg-fd-accent hover:text-fd-accent-foreground dark:hover:bg-fd-primary dark:hover:text-fd-primary-foreground hover:scale-105 ","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-tag opacity-60 transition-opacity group-hover:opacity-100","aria-hidden":"true","children":[["$","path","vktsd0",{"d":"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"}],["$","circle","kqv944",{"cx":"7.5","cy":"7.5","r":".5","fill":"currentColor"}],"$undefined"]}],["$","span",null,{"children":"Weekly"}],false]}]]}],["$","div",null,{"children":[["$","p",null,{"children":"阴雨天已经连绵了差不多两周的时间，这个夏天的雨季感觉比往年都要来的更早一些。上周末，本赛季的英超比赛也已经踢完了。曼城提前两轮便锁定了英超冠军，最后的收官之战早已悬念不再。"}],"\n",["$","p",null,{"children":"回顾一下本周做的一些事情："}],"\n",["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"工具","children":[["$","a",null,{"data-card":"","href":"#工具","className":"peer","children":"工具"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["$","$La",null,{"href":"https://app.databerry.ai/agents","children":"databerry"}]}],"\n",["$","li",null,{"children":["$","$La",null,{"href":"https://gamma.app/","children":"gamma"}]}],"\n",["$","li",null,{"children":["$","$La",null,{"href":"https://github.com/NotJoeMartinez/yt-fts","children":"yt-fts"}]}],"\n"]}],"\n",["$","p",null,{"children":["最近在考虑如何动手实现一个可以训练自定义数据的 Bot，原理就是使用 ",["$","strong",null,{"children":"OpenAI"}]," 的 API，",["$","strong",null,{"children":"LangchainJS"}]," 以及",["$","strong",null,{"children":"向量数据库"}],"来完成。Databerry 是个无代码的平台支持使用自定义数据来实现 ChatGPT Agent，总体使用体验还不错。但是免费版的限制太多了，还没来得及深度体验，额度几乎已经用完了。"]}],"\n",["$","p",null,{"children":"上一周还参加了一个黑客松比赛，终于做了一把「全栈」开发——前端 + 智能合约 + PPT + 视频几乎都是由我一个人完成。其中 PPT 部分使用了 gamma 来做辅助。节省了我很多的时间，只需要把项目中 README 作为大纲丢到 gamma 中，它就能帮我完成 PPT 大体的框架。而且还有许多超棒的样式可以选择，想要修改布局也很方便。"}],"\n",["$","p",null,{"children":["yt-fts 是一个可以全文搜索 Youtube 频道中字幕的命令行工具。原理就是使用 ",["$","code",null,{"children":"yt-dlp"}]," 先下载该频道下所有视频的 subtitles 然后将其存到 ",["$","code",null,{"children":"sqlite"}]," 数据库中进行全文检索。最新的版本还支持使用 ",["$","code",null,{"children":"OpenAI embedings"}]," 来语义检索。"]}],"\n",["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"听的播客","children":[["$","a",null,{"data-card":"","href":"#听的播客","className":"peer","children":"听的播客"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[["$Lb","$Lc"],"$undefined"]}]]}],"\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12"],"className":"prose flex-1"}],"$L13","                          ","$L14"],"$L15","$L16"],"className":"flex min-w-0 w-full flex-col gap-4 pt-8 px-4 md:px-6 md:mx-auto"}],"$L17"]}]}],["$L18","$L19","$L1a","$L1b"],"$L1c"]}],"loading":null,"isPartial":false}
