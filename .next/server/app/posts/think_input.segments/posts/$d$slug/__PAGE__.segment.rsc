0:{"buildId":"0InbTxRoIjIMCiN8Wi9i7","rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#开始之前","title":"开始之前"},{"depth":2,"url":"#输入","title":"输入"},{"depth":3,"url":"#信息流","title":"信息流"},{"depth":3,"url":"#rss","title":"RSS"},{"depth":3,"url":"#看书和听播客","title":"看书和听播客"},{"depth":2,"url":"#code-方法","title":"CODE 方法"},{"depth":2,"url":"#想法","title":"想法"}],"single":false,"children":["$","div",null,{"id":"nd-page","className":"flex flex-1 w-full mx-auto max-w-(--fd-page-width) pt-(--fd-tocnav-height) pe-(--fd-toc-width)","children":[["$","$L3",null,{"children":[["$","$L4",null,{}],["$","$L5",null,{"children":["$undefined",["$","$L6",null,{"children":["$","$L7",null,{}]}],"$undefined"]}]]}],["$","article",null,{"children":[["$","$L8",null,{}],[["$","p",null,{"className":"text-right","children":"2023/5/19"}],["$","h1",null,{"children":"再谈输入 —— 《打造第二大脑》","className":"text-[1.75em] font-semibold"}],["$","p",null,{"className":"text-lg text-fd-muted-foreground mb-0","children":"读《打造第二大脑》后的实践总结：如何平衡算法推荐与主动订阅，以及如何利用 CODE 方法构建从“输入”到“输出”的闭环。"}],["$","div",null,{"className":"flex gap-2 flex-wrap mb-8","children":[["$","$L9","LHTL",{"href":"/tags/LHTL","className":" group inline-flex items-center gap-1.5  px-3 py-1  text-sm font-medium rounded-md bg-fd-secondary text-fd-secondary-foreground transition-all duration-300 ease-out hover:bg-fd-accent hover:text-fd-accent-foreground dark:hover:bg-fd-primary dark:hover:text-fd-primary-foreground hover:scale-105 ","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-tag opacity-60 transition-opacity group-hover:opacity-100","aria-hidden":"true","children":[["$","path","vktsd0",{"d":"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"}],["$","circle","kqv944",{"cx":"7.5","cy":"7.5","r":".5","fill":"currentColor"}],"$undefined"]}],["$","span",null,{"children":"LHTL"}],false]}]]}],["$","div",null,{"children":[["$","blockquote",null,{"children":["\n",["$","p",null,{"children":"『太多的资讯就如同太少的资讯一样，都是一种对理解力的阻碍。换句话说，现代的媒体正以压倒性的泛滥资讯阻碍了我们的理解力』"}],"\n"]}],"\n",["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"开始之前","children":[["$","a",null,{"data-card":"","href":"#开始之前","className":"peer","children":"开始之前"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","p",null,{"children":["很早就想写一篇关于自己如何做「信息管理」的文章了。前段时间看到 Twitter 上 Randy 的",["$","$La",null,{"href":"https://twitter.com/randyloop/status/1657206677509398528","children":"分享"}],"以及读了《打造第二大脑》这本书。我也再次思考自己应该如何来做信息管理。"]}],"\n",["$","p",null,{"children":"对我而言，做好信息管理主要有两个目的："}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":"提升效率：在工作或生活中遇到难题时，能快速找到既有的解决方案"}],"\n",["$","li",null,{"children":"激发灵感：通过旧知识的碰撞，产生更多有趣的新想法"}],"\n"]}],"\n",["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"输入","children":[["$","a",null,{"data-card":"","href":"#输入","className":"peer","children":"输入"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","p",null,{"children":"目前我的信息输入主要分为三类：算法推荐的信息流、主动订阅的 RSS，以及读书和听播客。"}],"\n",["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"信息流","children":["$Lb","$Lc"]}],"\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21"],"className":"prose flex-1"}],"$L22","                          ","$L23"],"$L24","$L25"],"className":"flex min-w-0 w-full flex-col gap-4 pt-8 px-4 md:px-6 md:mx-auto"}],"$L26"]}]}],["$L27","$L28","$L29","$L2a"],"$L2b"]}],"loading":null,"isPartial":false}
b:["$","a",null,{"data-card":"","href":"#信息流","className":"peer","children":"信息流"}]
c:["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]
d:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Twitter"}],"\n",["$","li",null,{"children":"GitHub"}],"\n",["$","li",null,{"children":"Youtube"}],"\n",["$","li",null,{"children":"即刻"}],"\n"]}]
e:["$","p",null,{"children":"我在 Twitter 上关注了很多很棒的开发者，设计师，还有一些有趣产品的官推。从这些关注列表中可以看到他们最新的观点，又出现了哪些新的技术和产品。我把 Likes 当做收藏夹来使用，看到感兴趣的内容就会 like 一下。此外我还建了一些 Lists，这个功能算是一个分类吧，目前我建立的几个大类是 AI，FE，Web3。"}]
f:["$","p",null,{"children":["GitHub 其实也有信息流 —— 「For you」，这个可能是很多人不太用到的。从这里可以看到关注的开发者都 star 了哪些 repo，此外它也会推荐一些最近比较流行的项目。我会把 star 的 repo 进行分类，你可以在",["$","$La",null,{"href":"https://github.com/occupy5?tab=stars","children":"这里"}],"看到。"]}]
10:["$","p",null,{"children":["Youtube 上主要是浏览订阅的一些频道。内容其实就比较广泛了，技术，生活，娱乐都有。这个上面也时常能够发现高质量的内容，比如加州伯克利大学的 ",["$","$La",null,{"href":"https://www.youtube.com/@blockchain-web3moocs635","children":"Web3 Mooc"}],"，街头摄影师 ",["$","$La",null,{"href":"https://www.youtube.com/@KaiManWong","children":"Kai W"}],"，乒乓球博主 ",["$","$La",null,{"href":"https://www.youtube.com/@AdamBobrow","children":"Adam"}]," 等等。"]}]
11:["$","p",null,{"children":"即刻是一个很不错的中文社区，Web3 和 AI 的内容质量都还不错，也会有一些活跃的独立开发者和投资人。不过最新的科技资讯还是稍微滞后于 twitter。"}]
12:["$","p",null,{"children":["信息流最主要的特点就是——",["$","strong",null,{"children":"算法推荐"}],"，但它是一把双刃剑，有的时候会带来惊喜，发现更多有意思的人。另一方面则是很容易产生『信息过载』，用户总是一遍又一遍的刷新 APP。"]}]
13:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"rss","children":[["$","a",null,{"data-card":"","href":"#rss","className":"peer","children":"RSS"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
14:["$","p",null,{"children":["RSS 订阅是我常用的另一种获取信息的方式。主要用来订阅一些技术博客，当然也有一些其他主题的订阅源。如设计相关的，",["$","strong",null,{"children":"Behance"}],"，",["$","strong",null,{"children":"Design-Milk"}],"。科技相关的，",["$","strong",null,{"children":"9to5Mac"}],"，",["$","strong",null,{"children":"The Verge"}],"。Web3 相关的，",["$","strong",null,{"children":"Weekly in Etherum"}],"，",["$","strong",null,{"children":"Foresight news"}]," 等。"]}]
15:["$","p",null,{"children":"RSS 和信息流相比，我认为优势在于文章的质量会更高一些 —— 因为订阅源是经过自己筛选之后才放到阅读器中的。我会定期刷新阅读器，来获取这些高质量的信息输入。"}]
16:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"看书和听播客","children":[["$","a",null,{"data-card":"","href":"#看书和听播客","className":"peer","children":"看书和听播客"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
17:["$","p",null,{"children":"如果想要更加系统的学习一门知识，我认为看书还是最好的学习方式。当然阅读完一本专业书是一件很困难的事情。因为大部分的情况下，Google（或许现在可以直接问 ChatGPT）或看文档就能解决问题。很少有人会再去花费大量的时间搞懂问题的来龙去脉。"}]
18:["$","p",null,{"children":"播客的优势在于，获取到的是第一手的信息。比如我想了解 Sam 对未来 AI 发展的一些观点，去听相关的播客会比看相关媒体总结的文章可信度更高。"}]
19:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"code-方法","children":[["$","a",null,{"data-card":"","href":"#code-方法","className":"peer","children":"CODE 方法"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
1a:["$","p",null,{"children":"CODE 方法是《打造第二大脑》这本书中的的核心内容。下面谈谈我自己的一些实践。"}]
1b:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":["$","th",null,{"style":{"textAlign":"center"},"children":["$","$L2c",null,{"alt":"CODE","src":"https://blog-assets.shenn.xyz/think_input.png","width":"2142","height":"1249"}]}]}]}],["$","tbody",null,{"children":["$","tr",null,{"children":["$","td",null,{"style":{"textAlign":"center"},"children":["$","em",null,{"children":"CODE 方法"}]}]}]}]]}]}]
1c:["$","ul",null,{"children":["\n",["$","li",null,{"children":"C(Capture) -> 获取能引发共鸣的信息"}],"\n",["$","li",null,{"children":"O(Organize) -> 组织分类"}],"\n",["$","li",null,{"children":"D(Distill) -> 标注精髓部分"}],"\n",["$","li",null,{"children":"E(Express) -> 展示成果"}],"\n"]}]
1d:["$","p",null,{"children":["对于「Capture」部分，主要就是上面提到过的几种方式，还有就是我会使用 ",["$","strong",null,{"children":"Web Clipper"}]," 这个插件剪切网页文章到语雀知识库。然后在语雀知识库中进行「Organize」—— 通过",["$","strong",null,{"children":"文件夹分类"}],"的方式。再者就是在 Obsidian 上对",["$","strong",null,{"children":"写摘要"}],"完成「Distill」，最后就是写博客，发推特，发即刻来展示成果。"]}]
1e:["$","p",null,{"children":"完成这些步骤就走完了 CODE 方法完整的一套流程。当然在具体实践中要根据自己的情况做调整，每个人使用的工具也都不尽相同。对于我来讲，D 和 E 做的还不够，也即是「输出」这个部分。"}]
1f:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"想法","children":[["$","a",null,{"data-card":"","href":"#想法","className":"peer","children":"想法"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
20:["$","p",null,{"children":"做好信息管理，在学习新的技术或是解决不曾遇到过的问题时，不必要从零开始，而是建立在已有的知识库上。接下来，大语言模型加上个人知识库可能会让打造第二大脑的过程更加简单。但是无论方式如何，我们最应该关注的还是「看到过的信息，以后会去向哪里」。我想用之前看到过的关于 TypeScript 的一句话作为结尾。"}]
21:["$","blockquote",null,{"children":["\n",["$","p",null,{"children":"As you write TypeScript, you need to think about where you want your contracts to be, and what needs to be done in order to meet them."}],"\n"]}]
