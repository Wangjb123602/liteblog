e:["$","$1","c",{"children":[[["$","script","script-0",{"src":"/_next/static/chunks/abfef1dbd19ea81c.js","async":true,"nonce":"$undefined"}],["$","script","script-1",{"src":"/_next/static/chunks/b919113699b995ce.js","async":true,"nonce":"$undefined"}],["$","script","script-2",{"src":"/_next/static/chunks/95e63b77f68b0954.js","async":true,"nonce":"$undefined"}]],["$","$L18",null,{"tree":{"name":"Posts","children":[{"$id":"lhtl.mdx","type":"page","name":"学会学","description":"关于学习方法论的思考与实践：以 React + TypeScript 的学习为例，分享如何从零开始通过“严肃学习”掌握一门新技术。","icon":"$undefined","url":"/posts/lhtl","$ref":{"file":"lhtl.mdx"}},{"$id":"terminal.mdx","type":"page","name":"terminal折腾记之Mac篇","description":"本文记录了在 Mac 下对终端进行美化和功能增强的过程。通过配置 iTerm2、oh-my-zsh 以及 powerlevel9k 主题，配合自动补全和语法高亮插件，打造了一个既美观又高效的终端环境，并解决了 VS Code 中的字体适配问题。","icon":"$undefined","url":"/posts/terminal","$ref":{"file":"terminal.mdx"}},{"$id":"learn_japanese.mdx","type":"page","name":"日语入门","description":"日语入门笔记：从五十音起源 APP 开始，探索日文书写结构、汉字词义辨析与基础发音规则。","icon":"$undefined","url":"/posts/learn_japanese","$ref":{"file":"learn_japanese.mdx"}},{"$id":"named.mdx","type":"page","name":"变量命名的艺术","description":"变量命名指南：一篇关于如何优雅命名 Array、Boolean、Number 和 Function 的译文，旨在通过好的命名提升代码的可读性。","icon":"$undefined","url":"/posts/named","$ref":{"file":"named.mdx"}},{"$id":"vue_component01.mdx","type":"page","name":"动手实现一个vue分页组件","description":"本文记录了实现一个 Vue 分页组件的全过程，涵盖自定义页码数量、颜色主题及图标切换等需求分析。详细讲解了页码列表计算（minPage/maxPage）的核心逻辑，提供了 Props、Computed 和 Methods 的代码实现，并分享了关于编写独立组件与 API 设计的思考。","icon":"$undefined","url":"/posts/vue_component01","$ref":{"file":"vue_component01.mdx"}},{"$id":"git.mdx","type":"page","name":"每周分享 -- 重拾git","description":"Git 学习笔记：从核心原理出发，辨析 merge 与 rebase 的差异，并整理了本地与远程仓库版本回退的常用指令。","icon":"$undefined","url":"/posts/git","$ref":{"file":"git.mdx"}},{"$id":"Tang_Poems.mdx","type":"page","name":"初识格律诗创作","description":"格律诗创作入门笔记：从开源工具 cope 开始，解析平仄、押韵、对仗与黏连四大基本要素。","icon":"$undefined","url":"/posts/Tang_Poems","$ref":{"file":"Tang_Poems.mdx"}},{"$id":"EventLoop.mdx","type":"page","name":"再探js执行机制","description":"JS 执行机制深度解析：基于 Event Loop 模型，通过代码推演详细讲解了宏任务（Macro-task）与微任务（Micro-task）的执行差异。","icon":"$undefined","url":"/posts/EventLoop","$ref":{"file":"EventLoop.mdx"}},{"$id":"terminalWin.mdx","type":"page","name":"terminal折腾记之windows篇","description":"Windows Terminal 配置指南：集成 Oh My Posh、iTerm 配色与 Powerline 字体，打造舒适的 PowerShell 开发环境。","icon":"$undefined","url":"/posts/terminalWin","$ref":{"file":"terminalWin.mdx"}},{"$id":"podcast_01.mdx","type":"page","name":"听播客——《人口老龄化所带来银发经济的崛起》","description":"播客笔记：从日本银发经济的成熟案例（电子设备、洗浴增值服务等），看人口老龄化背景下智慧养老产业的创业与投资机会。","icon":"$undefined","url":"/posts/podcast_01","$ref":{"file":"podcast_01.mdx"}},{"$id":"weekly_101.mdx","type":"page","name":"Week in Mar 12, 2023","description":"一周回顾：常用 AI 工具推荐，LLM 生成原理深度解析（RLHF、概率分布），以及从 Embeddings 到独立开发者的机会思考。","icon":"$undefined","url":"/posts/weekly_101","$ref":{"file":"weekly_101.mdx"}},{"$id":"weekly_103.mdx","type":"page","name":"Week in April 16, 2023","description":"一周回顾：Chakra UI 与 React 技术文章阅读，Web3 与 AI 新品观察；结合《打造超人大脑》与《思考快与慢》两本书，深度反思学习方法与 AI 辅助阅读的边界。","icon":"$undefined","url":"/posts/weekly_103","$ref":{"file":"weekly_103.mdx"}},{"$id":"2023_state_of_web_component.mdx","type":"page","name":"2023 Web Components 现状","description":"2023 年 Web Components 生态报告：通过 Microsoft、Salesforce 等实战案例展示其成熟度，并详细梳理了 Shadow DOM 增强、Element Internals、声明式 Shadow DOM 以及 CSS 模块脚本等核心 API 的现状与未来提案。","icon":"$undefined","url":"/posts/2023_state_of_web_component","$ref":{"file":"2023_state_of_web_component.mdx"}},{"$id":"think_input.mdx","type":"page","name":"再谈输入 —— 《打造第二大脑》","description":"读《打造第二大脑》后的实践总结：如何平衡算法推荐与主动订阅，以及如何利用 CODE 方法构建从“输入”到“输出”的闭环。","icon":"$undefined","url":"/posts/think_input","$ref":{"file":"think_input.mdx"}},{"$id":"account_abstraction.mdx","type":"page","name":"Account Abstraction 初探","description":"深入浅出探讨以太坊账户抽象（Account Abstraction）与 ERC-4337 标准。从 EOA 账户的局限性出发，解析 AA 如何通过“可编程交易验证”解决私钥管理痛点，并带来 Gas 代付、社交恢复等 Web3 用户体验的革新。","icon":"$undefined","url":"/posts/account_abstraction","$ref":{"file":"account_abstraction.mdx"}},{"$id":"weekly_104.mdx","type":"page","name":"Week in Jun 04, 2023","description":"本周回顾了英超收官与连绵雨季。技术方面尝试了 Databerry、yt-fts 等工具，并利用 Gamma 辅助完成了黑客松项目；播客中聆听了尤雨溪关于 Vue 成功的思考，同时开始阅读迟子建的《额尔古纳河右岸》。","icon":"$undefined","url":"/posts/weekly_104","$ref":{"file":"weekly_104.mdx"}},{"$id":"prompt_for_developer.mdx","type":"page","name":"写给开发者看的 Prompt Engineering","description":"本文介绍了 Prompt Engineering 的核心技巧，包括编写明确具体的说明（使用分隔符、结构化输出、条件检查、Few-shot 提示）以及给模型思考时间。同时分析了 ai-code-translator 和 gpt-engineer 两个开源项目中的 Prompt 应用实例。","icon":"$undefined","url":"/posts/prompt_for_developer","$ref":{"file":"prompt_for_developer.mdx"}},{"$id":"jiangyou.mdx","type":"page","name":"城市漫步——去江油走走停停","description":"城市漫步随笔：四川江油的短途旅行。记录旅途中的人与事，李白故里的文化印记，以及关于“把自己作为方法”的思考。","icon":"$undefined","url":"/posts/jiangyou","$ref":{"file":"jiangyou.mdx"}},{"$id":"weekly_106.mdx","type":"page","name":"Week in Aug 20, 2023","description":"一周回顾：《置身事内》读书笔记与阅读工具分享，Unlock Protocol 的 NFT 门票系统解析，AI Agent 播客听后感，以及窦靖童新专辑推荐。","icon":"$undefined","url":"/posts/weekly_106","$ref":{"file":"weekly_106.mdx"}},{"$id":"weekly_107.mdx","type":"page","name":"Week in Feb 22, 2024","description":"本周阅读了王小波的《黄金时代》与福楼拜的《包法利夫人》，感受直率的性描写与精雕细琢的人物刻画；分享了三段来自播客的读者来信，记录了那些朦胧、遗憾却美好的情感瞬间。","icon":"$undefined","url":"/posts/weekly_107","$ref":{"file":"weekly_107.mdx"}},{"$id":"weekly_108.mdx","type":"page","name":"Week in Mar 29, 2024","description":"一周回顾：财报分析与东京生活随笔阅读，AI 叙事逻辑与多巴胺机制的深度思考，以及前端自动化、Vue 生态等技术资源分享。","icon":"$undefined","url":"/posts/weekly_108","$ref":{"file":"weekly_108.mdx"}},{"$id":"weekly_109.mdx","type":"page","name":"Week in June 08, 2024","description":"本周回顾：尝试 Web3 + AI 创作，发布了两个解决实际问题的 MyShell Bot；关注 Telegram Mini App 生态发展；重读浏览器原理并思考如何做好技术面试官。","icon":"$undefined","url":"/posts/weekly_109","$ref":{"file":"weekly_109.mdx"}},{"$id":"weekly_110.mdx","type":"page","name":"浏览器工作原理","description":"深入解析现代浏览器的工作原理，从 Chrome 的多进程架构切入，详细拆解浏览器进程与渲染进程的核心职责，揭示从代码到可视网页背后的渲染机制与安全设计。","icon":"$undefined","url":"/posts/weekly_110","$ref":{"file":"weekly_110.mdx"}},{"$id":"weekly_111.mdx","type":"page","name":"Week in Oct 28, 2024","description":"本周重温了宁浩的《无人区》，在纪录片《他乡的童年》中思考芬兰与日本的教育差异；游戏推荐富有想象力的《星之卡比》，并分享了 MindSearch、MemFree 等 AI 相关的开源项目。","icon":"$undefined","url":"/posts/weekly_111","$ref":{"file":"weekly_111.mdx"}},{"$id":"megi.mdx","type":"page","name":"Megi — 将线性对话，生长为思考的知识树","description":"比答案更重要的是提问的逻辑。介绍我开发的工具 Megi — 它不仅是一个对话整理插件，更能将杂乱的 AI 对话记录重构为可视化的“思考树”，让发散的思维路径变得清晰可循，且数据完全本地存储。","icon":"$undefined","url":"/posts/megi","$ref":{"file":"megi.mdx"}},{"$id":"search.mdx","type":"page","name":"优化搜索结果去广告的油猴脚本","description":"一个优化搜索结果去广告的油猴脚本。","icon":"$undefined","url":"/posts/search","$ref":{"file":"search.mdx"}},{"$id":"no-reCAPTCHA.mdx","type":"page","name":"reCAPTCHA验证码实在太反人类？快来试试这个自动跳过reCAPTCHA验证码的神器！","description":"一个跳过reCAPTCHA的工具。","icon":"$undefined","url":"/posts/no-reCAPTCHA","$ref":{"file":"no-reCAPTCHA.mdx"}},{"$id":"turnoffthelights.mdx","type":"page","name":"关灯看视频 – 观看视频时自动调暗页面","description":" 关灯看视频是一款能够在浏览器上播放视频的时候，自动调暗视频以外区域亮度，让你有一种置身于电影院中观影的感觉。支持众多浏览器。","icon":"$undefined","url":"/posts/turnoffthelights","$ref":{"file":"turnoffthelights.mdx"}},{"$id":"refactor_blog.mdx","type":"page","name":"重构博客：从 xLog 回归 Fumadocs","description":"记录将个人博客从 xLog 迁移至基于 Next.js 和 Fumadocs 的自建方案的过程，探索极致的开发者体验。","icon":"$undefined","url":"/posts/refactor_blog","$ref":{"file":"refactor_blog.mdx"}}]},"children":"$L19"}]]}]
