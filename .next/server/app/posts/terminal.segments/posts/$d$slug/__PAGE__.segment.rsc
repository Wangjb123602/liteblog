37:T77c,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"terminal折腾记之Mac篇","description":"本文记录了在 Mac 下对终端进行美化和功能增强的过程。通过配置 iTerm2、oh-my-zsh 以及 powerlevel9k 主题，配合自动补全和语法高亮插件，打造了一个既美观又高效的终端环境，并解决了 VS Code 中的字体适配问题。","image":"http://localhost:3000/api/og?title=terminal%E6%8A%98%E8%85%BE%E8%AE%B0%E4%B9%8BMac%E7%AF%87&description=%E6%9C%AC%E6%96%87%E8%AE%B0%E5%BD%95%E4%BA%86%E5%9C%A8+Mac+%E4%B8%8B%E5%AF%B9%E7%BB%88%E7%AB%AF%E8%BF%9B%E8%A1%8C%E7%BE%8E%E5%8C%96%E5%92%8C%E5%8A%9F%E8%83%BD%E5%A2%9E%E5%BC%BA%E7%9A%84%E8%BF%87%E7%A8%8B%E3%80%82%E9%80%9A%E8%BF%87%E9%85%8D%E7%BD%AE+iTerm2%E3%80%81oh-my-zsh+%E4%BB%A5%E5%8F%8A+powerlevel9k+%E4%B8%BB%E9%A2%98%EF%BC%8C%E9%85%8D%E5%90%88%E8%87%AA%E5%8A%A8%E8%A1%A5%E5%85%A8%E5%92%8C%E8%AF%AD%E6%B3%95%E9%AB%98%E4%BA%AE%E6%8F%92%E4%BB%B6%EF%BC%8C%E6%89%93%E9%80%A0%E4%BA%86%E4%B8%80%E4%B8%AA%E6%97%A2%E7%BE%8E%E8%A7%82%E5%8F%88%E9%AB%98%E6%95%88%E7%9A%84%E7%BB%88%E7%AB%AF%E7%8E%AF%E5%A2%83%EF%BC%8C%E5%B9%B6%E8%A7%A3%E5%86%B3%E4%BA%86+VS+Code+%E4%B8%AD%E7%9A%84%E5%AD%97%E4%BD%93%E9%80%82%E9%85%8D%E9%97%AE%E9%A2%98%E3%80%82","datePublished":"2018-10-20T00:00:00.000Z","dateModified":"2026-04-24T13:53:56.000Z","mainEntityOfPage":{"@type":"WebPage","@id":"http://localhost:3000/posts/terminal"},"author":{"@type":"Person","name":"shenn.xyz","url":"https://shenn.xyz"},"publisher":{"@type":"Person","name":"shenn.xyz"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"王浚博的博客","item":"http://localhost:3000/"},{"@type":"ListItem","position":2,"name":"王浚博的博客 | 文章列表","item":"http://localhost:3000/list"},{"@type":"ListItem","position":3,"name":"terminal折腾记之Mac篇","item":"http://localhost:3000/posts/terminal"}]}]}2b:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$37"}}]
