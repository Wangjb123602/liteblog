33:["$","ul",null,{"children":["\n",["$","li",null,{"children":["首先整体script进入主线程，遇到",["$","code",null,{"children":"console.log()"}],"，立即输出『开始了』"]}],"\n",["$","li",null,{"children":["接下来遇到",["$","code",null,{"children":"setTimeout"}],"，2s后回调函数function()被分发到宏任务Event Queue中（注意这里不是2s后",["$","strong",null,{"children":"执行"}],"），这里标记为setTimeout1"]}],"\n",["$","li",null,{"children":["遇到",["$","code",null,{"children":"for"}],"，直接执行，同理",["$","code",null,{"children":"setTimeout"}],"中的回调函数被分发到宏任务Event Queue中（这里涉及到闭包的知识），标记为setTimeout2，然后执行",["$","code",null,{"children":"console.log"}],"，输出『1，2，3，4，5』"]}],"\n",["$","li",null,{"children":["遇到",["$","code",null,{"children":"promise"}],",",["$","code",null,{"children":"new Promise"}],"直接执行，输出『promise1』。",["$","code",null,{"children":"then"}],"被分发到微任务Event Queue中，标记为then1"]}],"\n",["$","li",null,{"children":["接下来又遇到了一个",["$","code",null,{"children":"setTimeout"}],"，1s后回调函数function()被分发到宏任务Event Queue中，标记为setTimeout3"]}],"\n",["$","li",null,{"children":["又遇到",["$","code",null,{"children":"promise"}],"，同理，输出『promise2』，",["$","code",null,{"children":"then"}],"被分发到微任务Event Queue中，标记为then2"]}],"\n"]}]
34:["$","p",null,{"children":"第一轮事件循环的宏任务已经执行完毕。Event Queue中的任务如下表所示"}]
35:["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"style":{"textAlign":"center"},"children":["$","strong",null,{"children":"宏任务"}]}],["$","th",null,{"style":{"textAlign":"center"},"children":["$","strong",null,{"children":"微任务"}]}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"style":{"textAlign":"center"},"children":"setTimeout1(2s later)"}],["$","td",null,{"style":{"textAlign":"center"},"children":"then1"}]]}],["$","tr",null,{"children":[["$","td",null,{"style":{"textAlign":"center"},"children":"setTimeout2(1s later)"}],["$","td",null,{"style":{"textAlign":"center"},"children":"then2"}]]}],["$","tr",null,{"children":[["$","td",null,{"style":{"textAlign":"center"},"children":"setTimeout3(1s later)"}],["$","td",null,{"style":{"textAlign":"center"}}]]}]]}]]}]}]
36:["$","p",null,{"children":["根据上面的流程图，宏任务执行完后，js引擎的监视进程会检查此时有没有可以执行的微任务。这时后分发到微任务Event Queue的",["$","code",null,{"children":"then"}],"将被执行。依次输出『then1』，『then2』"]}]
