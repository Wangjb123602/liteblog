2b:T665,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"城市漫步——去江油走走停停","description":"城市漫步随笔：四川江油的短途旅行。记录旅途中的人与事，李白故里的文化印记，以及关于“把自己作为方法”的思考。","image":"http://localhost:3000/api/og?title=%E5%9F%8E%E5%B8%82%E6%BC%AB%E6%AD%A5%E2%80%94%E2%80%94%E5%8E%BB%E6%B1%9F%E6%B2%B9%E8%B5%B0%E8%B5%B0%E5%81%9C%E5%81%9C&description=%E5%9F%8E%E5%B8%82%E6%BC%AB%E6%AD%A5%E9%9A%8F%E7%AC%94%EF%BC%9A%E5%9B%9B%E5%B7%9D%E6%B1%9F%E6%B2%B9%E7%9A%84%E7%9F%AD%E9%80%94%E6%97%85%E8%A1%8C%E3%80%82%E8%AE%B0%E5%BD%95%E6%97%85%E9%80%94%E4%B8%AD%E7%9A%84%E4%BA%BA%E4%B8%8E%E4%BA%8B%EF%BC%8C%E6%9D%8E%E7%99%BD%E6%95%85%E9%87%8C%E7%9A%84%E6%96%87%E5%8C%96%E5%8D%B0%E8%AE%B0%EF%BC%8C%E4%BB%A5%E5%8F%8A%E5%85%B3%E4%BA%8E%E2%80%9C%E6%8A%8A%E8%87%AA%E5%B7%B1%E4%BD%9C%E4%B8%BA%E6%96%B9%E6%B3%95%E2%80%9D%E7%9A%84%E6%80%9D%E8%80%83%E3%80%82","datePublished":"2023-07-07T00:00:00.000Z","dateModified":"2026-04-24T13:53:56.000Z","mainEntityOfPage":{"@type":"WebPage","@id":"http://localhost:3000/posts/jiangyou"},"author":{"@type":"Person","name":"shenn.xyz","url":"https://shenn.xyz"},"publisher":{"@type":"Person","name":"shenn.xyz"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"王浚博的博客","item":"http://localhost:3000/"},{"@type":"ListItem","position":2,"name":"王浚博的博客 | 文章列表","item":"http://localhost:3000/list"},{"@type":"ListItem","position":3,"name":"城市漫步——去江油走走停停","item":"http://localhost:3000/posts/jiangyou"}]}]}21:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2b"}}]
