(contract account)，不能",["$","strong",null,{"children":"主动发起交易"}]]}],"\n"]}],"\n",["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"为什么提出账户抽象","children":[["$","a",null,{"data-card":"","href":"#为什么提出账户抽象","className":"peer","children":"为什么提出「账户抽象」"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[["$La","$Lb"],"$undefined"]}]]}],"\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c"],"className":"prose flex-1"}],"$L1d","                          ","$L1e"],"$L1f","$L20"],"className":"flex min-w-0 w-full flex-col gap-4 pt-8 px-4 md:px-6 md:mx-auto"}],"$L21"]}]}],["$L22","$L23","$L24","$L25"],"$L26"]}],"loading":null,"isPartial":false}
