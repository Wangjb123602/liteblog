29:T74c,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"Account Abstraction 初探","description":"深入浅出探讨以太坊账户抽象（Account Abstraction）与 ERC-4337 标准。从 EOA 账户的局限性出发，解析 AA 如何通过“可编程交易验证”解决私钥管理痛点，并带来 Gas 代付、社交恢复等 Web3 用户体验的革新。","image":"http://localhost:3000/api/og?title=Account+Abstraction+%E5%88%9D%E6%8E%A2&description=%E6%B7%B1%E5%85%A5%E6%B5%85%E5%87%BA%E6%8E%A2%E8%AE%A8%E4%BB%A5%E5%A4%AA%E5%9D%8A%E8%B4%A6%E6%88%B7%E6%8A%BD%E8%B1%A1%EF%BC%88Account+Abstraction%EF%BC%89%E4%B8%8E+ERC-4337+%E6%A0%87%E5%87%86%E3%80%82%E4%BB%8E+EOA+%E8%B4%A6%E6%88%B7%E7%9A%84%E5%B1%80%E9%99%90%E6%80%A7%E5%87%BA%E5%8F%91%EF%BC%8C%E8%A7%A3%E6%9E%90+AA+%E5%A6%82%E4%BD%95%E9%80%9A%E8%BF%87%E2%80%9C%E5%8F%AF%E7%BC%96%E7%A8%8B%E4%BA%A4%E6%98%93%E9%AA%8C%E8%AF%81%E2%80%9D%E8%A7%A3%E5%86%B3%E7%A7%81%E9%92%A5%E7%AE%A1%E7%90%86%E7%97%9B%E7%82%B9%EF%BC%8C%E5%B9%B6%E5%B8%A6%E6%9D%A5+Gas+%E4%BB%A3%E4%BB%98%E3%80%81%E7%A4%BE%E4%BA%A4%E6%81%A2%E5%A4%8D%E7%AD%89+Web3+%E7%94%A8%E6%88%B7%E4%BD%93%E9%AA%8C%E7%9A%84%E9%9D%A9%E6%96%B0%E3%80%82","datePublished":"2023-05-23T12:00:00.000Z","dateModified":"2026-04-24T13:53:56.000Z","mainEntityOfPage":{"@type":"WebPage","@id":"http://localhost:3000/posts/account_abstraction"},"author":{"@type":"Person","name":"shenn.xyz","url":"https://shenn.xyz"},"publisher":{"@type":"Person","name":"shenn.xyz"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"王浚博的博客","item":"http://localhost:3000/"},{"@type":"ListItem","position":2,"name":"王浚博的博客 | 文章列表","item":"http://localhost:3000/list"},{"@type":"ListItem","position":3,"name":"Account Abstraction 初探","item":"http://localhost:3000/posts/account_abstraction"}]}]}1e:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$29"}}]
