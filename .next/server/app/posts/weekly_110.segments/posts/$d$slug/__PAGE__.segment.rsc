29:T6c7,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"浏览器工作原理","description":"深入解析现代浏览器的工作原理，从 Chrome 的多进程架构切入，详细拆解浏览器进程与渲染进程的核心职责，揭示从代码到可视网页背后的渲染机制与安全设计。","image":"http://localhost:3000/api/og?title=%E6%B5%8F%E8%A7%88%E5%99%A8%E5%B7%A5%E4%BD%9C%E5%8E%9F%E7%90%86&description=%E6%B7%B1%E5%85%A5%E8%A7%A3%E6%9E%90%E7%8E%B0%E4%BB%A3%E6%B5%8F%E8%A7%88%E5%99%A8%E7%9A%84%E5%B7%A5%E4%BD%9C%E5%8E%9F%E7%90%86%EF%BC%8C%E4%BB%8E+Chrome+%E7%9A%84%E5%A4%9A%E8%BF%9B%E7%A8%8B%E6%9E%B6%E6%9E%84%E5%88%87%E5%85%A5%EF%BC%8C%E8%AF%A6%E7%BB%86%E6%8B%86%E8%A7%A3%E6%B5%8F%E8%A7%88%E5%99%A8%E8%BF%9B%E7%A8%8B%E4%B8%8E%E6%B8%B2%E6%9F%93%E8%BF%9B%E7%A8%8B%E7%9A%84%E6%A0%B8%E5%BF%83%E8%81%8C%E8%B4%A3%EF%BC%8C%E6%8F%AD%E7%A4%BA%E4%BB%8E%E4%BB%A3%E7%A0%81%E5%88%B0%E5%8F%AF%E8%A7%86%E7%BD%91%E9%A1%B5%E8%83%8C%E5%90%8E%E7%9A%84%E6%B8%B2%E6%9F%93%E6%9C%BA%E5%88%B6%E4%B8%8E%E5%AE%89%E5%85%A8%E8%AE%BE%E8%AE%A1%E3%80%82","datePublished":"2024-10-07T00:00:00.000Z","dateModified":"2026-04-24T13:53:56.000Z","mainEntityOfPage":{"@type":"WebPage","@id":"http://localhost:3000/posts/weekly_110"},"author":{"@type":"Person","name":"shenn.xyz","url":"https://shenn.xyz"},"publisher":{"@type":"Person","name":"shenn.xyz"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"王浚博的博客","item":"http://localhost:3000/"},{"@type":"ListItem","position":2,"name":"王浚博的博客 | 文章列表","item":"http://localhost:3000/list"},{"@type":"ListItem","position":3,"name":"浏览器工作原理","item":"http://localhost:3000/posts/weekly_110"}]}]}1d:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$29"}}]
