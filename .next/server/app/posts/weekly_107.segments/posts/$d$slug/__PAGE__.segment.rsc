0:{"buildId":"0InbTxRoIjIMCiN8Wi9i7","rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#读书","title":"读书"},{"depth":2,"url":"#播客","title":"播客"},{"depth":3,"url":"#未寄出的月光","title":"未寄出的月光"},{"depth":3,"url":"#余光里的你","title":"余光里的你"},{"depth":3,"url":"#告白的意义","title":"告白的意义"},{"depth":2,"url":"#footnote-label","title":"Footnotes"}],"single":false,"children":["$","div",null,{"id":"nd-page","className":"flex flex-1 w-full mx-auto max-w-(--fd-page-width) pt-(--fd-tocnav-height) pe-(--fd-toc-width)","children":[["$","$L3",null,{"children":[["$","$L4",null,{}],["$","$L5",null,{"children":["$undefined",["$","$L6",null,{"children":["$","$L7",null,{}]}],"$undefined"]}]]}],["$","article",null,{"children":[["$","$L8",null,{}],[["$","p",null,{"className":"text-right","children":"2024/2/22"}],["$","h1",null,{"children":"Week in Feb 22, 2024","className":"text-[1.75em] font-semibold"}],["$","p",null,{"className":"text-lg text-fd-muted-foreground mb-0","children":"本周阅读了王小波的《黄金时代》与福楼拜的《包法利夫人》，感受直率的性描写与精雕细琢的人物刻画；分享了三段来自播客的读者来信，记录了那些朦胧、遗憾却美好的情感瞬间。"}],["$","div",null,{"className":"flex gap-2 flex-wrap mb-8","children":[["$","$L9","Weekly",{"href":"/tags/Weekly","className":" group inline-flex items-center gap-1.5  px-3 py-1  text-sm font-medium rounded-md bg-fd-secondary text-fd-secondary-foreground transition-all duration-300 ease-out hover:bg-fd-accent hover:text-fd-accent-foreground dark:hover:bg-fd-primary dark:hover:text-fd-primary-foreground hover:scale-105 ","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-tag opacity-60 transition-opacity group-hover:opacity-100","aria-hidden":"true","children":[["$","path","vktsd0",{"d":"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"}],["$","circle","kqv944",{"cx":"7.5","cy":"7.5","r":".5","fill":"currentColor"}],"$undefined"]}],["$","span",null,{"children":"Weekly"}],false]}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"读书","children":[["$","a",null,{"data-card":"","href":"#读书","className":"peer","children":"读书"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","p",null,{"children":"这段时间主要看了两本书，《黄金时代》和《包法利夫人》。"}],"\n",["$","p",null,{"children":"之前看过王小波的两本书，一本是《沉默的大多数》，另外一本是他和李银河写的《爱你就像爱生命》。他的文字诙谐易懂，读起来毫不费劲。读他的书就像是和一个非常真诚直率幽默的人在聊天。"}],"\n",["$","p",null,{"children":"这本《黄金时代》我才刚开始读到第一部分，这是王二人生中的少年时代，充斥着非常多直接而坦率关于性的描写。"}],"\n",["$","blockquote",null,{"children":["\n",["$","p",null,{"children":"那一天我二十一岁，在我一生的黄金时代，我有好多奢望。我想爱，想吃，还想在一瞬间变成天上半明半暗的云。"}],"\n"]}],"\n",["$","p",null,{"children":"至于《包法利夫人》，令我印象深刻的是作者的语言艺术。太多关于人物精雕细琢的描写了。"}],"\n",["$","blockquote",null,{"children":["\n",["$","p",null,{"children":"而且寡妇瘦括括的，牙又长，整年披一件小黑披肩，尖尖头搭在肩胛骨之间；骨头一把，套上袍子，就像剑入了鞘一样。"}],"\n"]}],"\n",["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"播客","children":[["$","a",null,{"data-card":"","href":"#播客","className":"peer","children":"播客"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","p",null,{"children":["下面的几段内容，摘选自我前两天听的播客",["$","sup",null,{"children":["$","$La",null,{"href":"#user-content-fn-1","id":"user-content-fnref-1","data-footnote-ref":true,"aria-describedby":"footnote-label","children":"1"}]}]," 和之前收藏的一期播客","$Lb","。都是读者的来信，这种还未捅破窗户纸的朦胧情感读起来特别让人着迷。"]}],"\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12"],"className":"prose flex-1"}],"$L13","                          ","$L14"],"$L15","$L16"],"className":"flex min-w-0 w-full flex-col gap-4 pt-8 px-4 md:px-6 md:mx-auto"}],"$L17"]}]}],["$L18","$L19","$L1a","$L1b"],"$L1c"]}],"loading":null,"isPartial":false}
