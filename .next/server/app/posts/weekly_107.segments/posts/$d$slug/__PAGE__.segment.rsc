1e:T728,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"Week in Feb 22, 2024","description":"本周阅读了王小波的《黄金时代》与福楼拜的《包法利夫人》，感受直率的性描写与精雕细琢的人物刻画；分享了三段来自播客的读者来信，记录了那些朦胧、遗憾却美好的情感瞬间。","image":"http://localhost:3000/api/og?title=Week+in+Feb+22%2C+2024&description=%E6%9C%AC%E5%91%A8%E9%98%85%E8%AF%BB%E4%BA%86%E7%8E%8B%E5%B0%8F%E6%B3%A2%E7%9A%84%E3%80%8A%E9%BB%84%E9%87%91%E6%97%B6%E4%BB%A3%E3%80%8B%E4%B8%8E%E7%A6%8F%E6%A5%BC%E6%8B%9C%E7%9A%84%E3%80%8A%E5%8C%85%E6%B3%95%E5%88%A9%E5%A4%AB%E4%BA%BA%E3%80%8B%EF%BC%8C%E6%84%9F%E5%8F%97%E7%9B%B4%E7%8E%87%E7%9A%84%E6%80%A7%E6%8F%8F%E5%86%99%E4%B8%8E%E7%B2%BE%E9%9B%95%E7%BB%86%E7%90%A2%E7%9A%84%E4%BA%BA%E7%89%A9%E5%88%BB%E7%94%BB%EF%BC%9B%E5%88%86%E4%BA%AB%E4%BA%86%E4%B8%89%E6%AE%B5%E6%9D%A5%E8%87%AA%E6%92%AD%E5%AE%A2%E7%9A%84%E8%AF%BB%E8%80%85%E6%9D%A5%E4%BF%A1%EF%BC%8C%E8%AE%B0%E5%BD%95%E4%BA%86%E9%82%A3%E4%BA%9B%E6%9C%A6%E8%83%A7%E3%80%81%E9%81%97%E6%86%BE%E5%8D%B4%E7%BE%8E%E5%A5%BD%E7%9A%84%E6%83%85%E6%84%9F%E7%9E%AC%E9%97%B4%E3%80%82","datePublished":"2024-02-22T00:00:00.000Z","dateModified":"2026-04-24T13:53:56.000Z","mainEntityOfPage":{"@type":"WebPage","@id":"http://localhost:3000/posts/weekly_107"},"author":{"@type":"Person","name":"shenn.xyz","url":"https://shenn.xyz"},"publisher":{"@type":"Person","name":"shenn.xyz"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"王浚博的博客","item":"http://localhost:3000/"},{"@type":"ListItem","position":2,"name":"王浚博的博客 | 文章列表","item":"http://localhost:3000/list"},{"@type":"ListItem","position":3,"name":"Week in Feb 22, 2024","item":"http://localhost:3000/posts/weekly_107"}]}]}14:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1e"}}]
