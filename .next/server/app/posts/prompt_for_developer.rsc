地唱着歌爬山时，不幸降临了——杰克被石头绊倒了，滚下山坡，吉尔也跟着摔了下来。 "}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#FFAB70"},"children":"虽然受了轻伤，万幸两人还是平安回家了。尽管发生了不幸，但他们的冒险精神却丝毫没有减弱，他们将继续探索大自然。"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#FFAB70"},"children":"`"}]}],"\n",["$","span",null,{"className":"line"}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#C2C3C5","--shiki-dark":"#6B737C"},"children":"// 示例"}]}],"\n",["$","span",null,{"className":"line","children":[["$","span",null,{"style":{"--shiki-light":"#D32F2F","--shiki-dark":"#F97583"},"children":"const"}],["$","span",null,{"style":{"--shiki-light":"#1976D2","--shiki-dark":"#79B8FF"},"children":" prompt"}],["$","span",null,{"style":{"--shiki-light":"#D32F2F","--shiki-dark":"#F97583"},"children":" ="}],["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#FFAB70"},"children":" `"}]]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#FFAB70"},"children":"执行以下操作："}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#FFAB70"},"children":"1-请使用一句话概括给出的文本内容。"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#FFAB70"},"children":"2-将摘要翻译成法语。"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#FFAB70"},"children":"3-列出法语摘要中的每个名称。"}]}],"\n",["$","span",null,{"className":"line","children":["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#FFAB70"},"children":"4-输出一个包含以下键的 json 对象：french_summary，num_names。"}]}],"\n",["$","span",null,{"className":"line"}],"\n",["$","span",null,{"className":"line","children":["$