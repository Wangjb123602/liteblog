0:{"buildId":"0InbTxRoIjIMCiN8Wi9i7","rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#学习方式","title":"学习方式"},{"depth":2,"url":"#组成结构","title":"组成结构"},{"depth":2,"url":"#日文汉字","title":"日文汉字"},{"depth":2,"url":"#50音学习","title":"50音学习"},{"depth":3,"url":"#发音","title":"发音"},{"depth":4,"url":"#清音","title":"清音"},{"depth":4,"url":"#浊音","title":"浊音"},{"depth":4,"url":"#半浊音","title":"半浊音"},{"depth":4,"url":"#长音","title":"长音"},{"depth":2,"url":"#footnote-label","title":"Footnotes"}],"single":false,"children":["$","div",null,{"id":"nd-page","className":"flex flex-1 w-full mx-auto max-w-(--fd-page-width) pt-(--fd-tocnav-height) pe-(--fd-toc-width)","children":[["$","$L3",null,{"children":[["$","$L4",null,{}],["$","$L5",null,{"children":["$undefined",["$","$L6",null,{"children":["$","$L7",null,{}]}],"$undefined"]}]]}],["$","article",null,{"children":[["$","$L8",null,{}],[["$","p",null,{"className":"text-right","children":"2019/3/23"}],["$","h1",null,{"children":"日语入门","className":"text-[1.75em] font-semibold"}],["$","p",null,{"className":"text-lg text-fd-muted-foreground mb-0","children":"日语入门笔记：从五十音起源 APP 开始，探索日文书写结构、汉字词义辨析与基础发音规则。"}],["$","div",null,{"className":"flex gap-2 flex-wrap mb-8","children":[["$","$L9","日语学习",{"href":"/tags/日语学习","className":" group inline-flex items-center gap-1.5  px-3 py-1  text-sm font-medium rounded-md bg-fd-secondary text-fd-secondary-foreground transition-all duration-300 ease-out hover:bg-fd-accent hover:text-fd-accent-foreground dark:hover:bg-fd-primary dark:hover:text-fd-primary-foreground hover:scale-105 ","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-tag opacity-60 transition-opacity group-hover:opacity-100","aria-hidden":"true","children":[["$","path","vktsd0",{"d":"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"}],["$","circle","kqv944",{"cx":"7.5","cy":"7.5","r":".5","fill":"currentColor"}],"$undefined"]}],["$","span",null,{"children":"日语学习"}],false]}]]}],["$","div",null,{"children":[["$","p",null,{"children":["学习日语已经有一周多的时间了，这一周的时间主要是基础部分的学习。包括日文的结构，五十音的读写和发音。\n为什么要学习日语呢？直接原因是，一周前，我看了少数派的一篇文章——",["$","$La",null,{"href":"https://sspai.com/post/53020","children":"《聊一聊50音起源的再设计》"}],"。作者是一名独立开发者，对产品设计与体验有着极致的追求。然后我便在ipad上体验了这个app。与其说是一个学习的app，不如说它是一个艺术品。于是，我决定立即学习日语（🆒）。\n当然也有很多其他的原因，例如日语发音很好听，想要学习ruby，喜欢听日文歌之类的。\n日式料理马上就要开始了，只有app作为食材是完全不够的。作为一个完全零基础的日语学习者，一开始，我甚至不知道50音是什么。所以我决定在mooc上选择一门入门的课程。mooc上有很多关于日语学习的课程，看了课程的视频简介后，我选择《自由自在日本行》作为我的入门零基础入门课程。一边学习日语，一边还能了解日本的文化与名胜。すごい！"]}],"\n",["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"学习方式","children":[["$","a",null,{"data-card":"","href":"#学习方式","className":"peer","children":"学习方式"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"组成结构","children":[["$","a",null,{"data-card":"","href":"#组成结构","className":"peer","children":"组成结构"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"混合书写"}],"是日本文字表达的特色"]}],"\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26"],"className":"prose flex-1"}],"$L27","                          ","$L28"],"$L29","$L2a"],"className":"flex min-w-0 w-full flex-col gap-4 pt-8 px-4 md:px-6 md:mx-auto"}],"$L2b"]}]}],["$L2c","$L2d","$L2e","$L2f"],"$L30"]}],"loading":null,"isPartial":false}
b:["$","ul",null,{"children":["\n",["$","li",null,{"children":"万叶假名： 使用和日语同音的汉字来书写日文，以补足用汉语记录日语假名是相对于『真名（汉字）』而言的，假是『假借』的意思"}],"\n",["$","li",null,{"children":"日文汉字： 主要用于表达实物的名称和动作"}],"\n",["$","li",null,{"children":"平假名：日文中表音文字的一种，从万叶假名演化而来，形近汉语草书。主要用来标注日文汉字的注音，还有一些具有语法功能的助词和助动词"}],"\n",["$","li",null,{"children":["片假名：平安时代初期为了训读",["$","sup",null,{"children":["$","$La",null,{"href":"#user-content-fn-1","id":"user-content-fnref-1","data-footnote-ref":true,"aria-describedby":"footnote-label","children":"1"}]}],"汉文发明的。由万叶假名的楷书写法中简化而来。主要用来书写外来语，拟声拟态词"]}],"\n",["$","li",null,{"children":"罗马字：多用于招牌和广告"}],"\n"]}]
c:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"日文汉字","children":[["$","a",null,{"data-card":"","href":"#日文汉字","className":"peer","children":"日文汉字"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
d:["$","p",null,{"children":["中国人学习日语，自然是有天然的优势。因为汉语和日语都传承了",["$","strong",null,{"children":"古汉字"}],"的字形和字义，而且现代汉语中有很多词也借用了明治时期的",["$","strong",null,{"children":"日文翻译语"}],"。但在日文汉字中很多尽管字形和汉语相同，但含义却完全不同。"]}]
